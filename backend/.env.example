# Copy to .env and fill in. Leave a key blank to use the mock/fake stand-in for it.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=

# real | mock  (defaults to mock when TYPESAFE_API_KEY is blank)
# JEV_MODE=real
LLM_MODEL=claude-sonnet-5

CONFIDENCE_THRESHOLD=0.6
SLOT_CONFIDENCE=0.5
# Confidence a Noul Question's answer must meet to count as "yes" — e.g. adding
# an attendee, or a task having a deadline. Its own setting, separate from
# SLOT_CONFIDENCE; default 0.5 preserves prior behavior.
NOUL_CONFIDENCE=0.5
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost:5173
