# Copy to .env and fill in. Leave a key blank to use the mock/fake stand-in for it.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=

# real | mock  (defaults to mock when TYPESAFE_API_KEY is blank)
# JEV_MODE=real
LLM_MODEL=claude-sonnet-5

CONFIDENCE_THRESHOLD=0.6
SLOT_CONFIDENCE=0.5
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost:5173
